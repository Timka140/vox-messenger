# Копировать в build/remote/<node>/ssh.conf (каталог в .gitignore).
NODE_SSH=user@203.0.113.10
NODE_SSH_PORT=22
# IP узла (coturn listening-ip, fetch-logs).
NODE_IP=203.0.113.10
# Адрес узла для клиентов и кластера: DNS-имя или тот же IP. В git не попадает.
NODE_HOST=node1.example.org
# Только для узлов с NODE_SETUP=auto (build/setup-node.sh):
#NODE_ROOT_SSH=root@203.0.113.10
